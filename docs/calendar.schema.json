{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stbanmc.github.io/seasonly/calendar.schema.json",
  "title": "Seasonly calendar",
  "description": "Schema for a Seasonly calendar file. Validates id, version, and the array of seasons (each with either a fixed date or a moving-holiday rule).",
  "type": "object",
  "required": ["id", "seasons"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique calendar identifier, e.g. \"co\", \"mx\", \"global\", \"my-company-2026\"."
    },
    "name": { "type": "string", "description": "Human-readable calendar name." },
    "version": { "type": "string", "description": "SemVer string, used to allow safe migrations." },
    "seasons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/season" }
    }
  },
  "$defs": {
    "season": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "date": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
          "description": "Fixed date in MM-DD format (e.g. \"12-25\"). Mutually exclusive with rule."
        },
        "rule": {
          "type": "object",
          "description": "Moving holiday rule (e.g. 2nd Sunday of May). Mutually exclusive with date.",
          "required": ["type"],
          "properties": {
            "type": { "const": "weekday" },
            "month": { "type": "integer", "minimum": 1, "maximum": 12 },
            "weekday": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6,
              "description": "0=Sunday, 1=Monday, ..., 6=Saturday."
            },
            "occurrence": {
              "type": "integer",
              "description": "1..5 for the Nth occurrence; -1 for the last occurrence in the month."
            }
          },
          "required": ["type", "month", "weekday", "occurrence"]
        },
        "daysBefore": { "type": "integer", "minimum": 0, "default": 0 },
        "daysAfter": { "type": "integer", "minimum": 0, "default": 0 },
        "particles": {
          "type": "string",
          "enum": [
            "none", "snowflakes", "hearts", "confetti", "stars", "fireworks",
            "balloons", "flowers", "flags", "kites", "lightning", "candles",
            "bats", "leaves", "petals"
          ]
        },
        "gradient": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 },
          "description": "Two or more CSS colors to interpolate (any valid CSS color string)."
        },
        "textColor": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "required": ["date"] },
        { "required": ["rule"] }
      ]
    }
  }
}
